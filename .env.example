# FortiGate MCP Server configuration

# FortiGate hostname/IP, no scheme or port (required)
FORTIGATE_HOST=192.168.1.99

# HTTPS admin port (default: 443)
FORTIGATE_PORT=443

# REST API admin token (recommended). Create a REST API admin under
# System > Administrators, restrict it with trusted hosts, and generate a key.
FORTIGATE_API_TOKEN=your-api-token-here

# Alternative: admin username/password (session login; leave the token unset)
# FORTIGATE_USERNAME=admin
# FORTIGATE_PASSWORD=your-password-here

# VDOM used for every call (default: root)
FORTIGATE_VDOM=root

# TLS verification (false for the default self-signed certificate)
FORTIGATE_VERIFY_SSL=false

# Read-only mode: refuse every write; only GET requests reach the FortiGate (default: false)
FORTIGATE_READ_ONLY=false

# Only for activate_vm_eval_license (FortiCloud main account, 2FA off). Never passed as tool arguments.
# FORTICLOUD_ACCOUNT=you@example.com
# FORTICLOUD_PASSWORD=your-forticloud-password

# Optional: Kubernetes integration (k8s_* tools). The cluster is only read.
# K8S_KUBECONFIG=~/.kube/config
# K8S_CONTEXT=

# Optional: Proxmox integration (identify_clients, resolve_vms). Same variables as proxmox-mcp-server.
# A token with privilege separation and only the PVEAuditor role is enough.
# PROXMOX_HOST=192.168.1.10
# PROXMOX_USER=root@pam
# PROXMOX_TOKEN_NAME=fortigate-mcp
# PROXMOX_TOKEN_VALUE=your-token-secret
# PROXMOX_VERIFY_SSL=false
